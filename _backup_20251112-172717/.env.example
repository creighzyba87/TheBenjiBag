# TheBenjiBag Environment Variables Template
# Copy this file to Backend/.env and fill in your actual values

# Server Configuration
PORT=10000
NODE_ENV=production

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/thebenjibag?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_super_secret_jwt_string_at_least_64_characters_long

# MapTiler API Keys (get from https://www.maptiler.com/)
MAPTILER_ADMIN=your_maptiler_admin_key
MAPTILER_DRIVER=your_maptiler_driver_key
MAPTILER_CUSTOMER=your_maptiler_customer_key

# Brevo Email Service (get from https://www.brevo.com/)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_SECURE=false
BREVO_SMTP_USER=your_brevo_smtp_username
BREVO_SMTP_KEY=your_brevo_smtp_api_key
BREVO_SMTP_FROM=admin@thebenjibag.com

# Helcim Payment Processing (get from https://www.helcim.com/)
HELCIM_API_KEY=your_helcim_api_key
HELCIM_TEST_MODE=true

# CORS Configuration
# For local development:
# CORS_ORIGIN=http://localhost:5173
# For production (Render.com):
# CORS_ORIGIN=https://your-frontend-url.onrender.com
CORS_ORIGIN=http://localhost:5173

# Render Deployment (optional, for automated deployments)
RENDER_API_KEY=your_render_api_key
RENDER_SERVICE_ID=your_render_service_id
